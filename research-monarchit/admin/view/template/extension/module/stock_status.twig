{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="submit" form="form-category" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
                <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %} 
                <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %} 
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        {% if  error_warning %} 
        <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i>{{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %} 
        {% if session.data.success %}
            <div class="alert alert-success autoSlideUp"><i class="fa fa-check-circle"></i> {{ session.data.success }}
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
            <script>$('.autoSlideUp').delay(3000).fadeOut(600, function(){ $(this).show().css({'visibility':'hidden'}); }).slideUp(600);</script>
        {% endif %}
        
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-pencil"></i>{{ text_form }}</h3>
            </div>
            <br>
            <ul id="mmos_short_d" class="nav nav-tabs">
                <li class="active"><a href="#tab-setting" data-toggle="tab">{{ tab_setting }}</a></li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane active" id="tab-setting">
                    <div class="panel-body">
                        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-category" class="form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-status">{{ text_status }}</label>
                                <div class="col-sm-6">
                                    <select name="module_stock_status" id="input-status" class="form-control">
                                        {% if module_stock_status == '1' %} 
                                        <option value="1" selected="selected">{{ text_enabled }}</option>
                                        <option value="0">{{ text_disabled }}</option>
                                        {% else %}    
                                        <option value="1">{{ text_enabled }}</option>
                                        <option value="0" selected="selected">{{ text_disabled }}</option>
                                        {% endif %} 
                                    </select>
                                </div>
                                <div class="col-sm-4">&nbsp;</div>
                            </div>
                            
                            <div class="table-responsive">
                                <table id="status" class="table table-striped table-bordered table-hover">
                                  <thead>
                                    <tr>
                                      <td class="text-left">{{ entry_stock_status }}</td>
                                      <td class="text-left">{{ entry_hide_price }}</td>
                                      <td class="text-left">{{ entry_replace_text }}</td>
                                      <td class="text-left">{{ entry_hide_button }}</td>
                                      <td class="text-left">{{ entry_change_quantity }}</td>
                                      <td class="text-left">{{ entry_quantity }}</td>
                                      <td class="text-left">{{ entry_call_button }}</td>
                                      <td class="text-left">{{ entry_hide_from_search_category }}</td>
                                      <td></td>
                                    </tr>
                                  </thead>
                                  <tbody>
                
                                    {% set status_row = 0 %}
                                    {% for ss_data in stock_status_data %}
                                      <tr id="status-row{{ status_row }}">
                                        <td class="text-left" style="width: 40%;">
                                            <select name="stock_status_id[]" id="input-status" class="form-control">
                                            {% for stock_status in stock_statuses %}
                                            <option value="{{ stock_status.stock_status_id }}" {% if stock_status.stock_status_id == ss_data.stock_status_id %} selected {% endif %}>{{ stock_status.name }}</option>
                                            {% endfor %} 
                                            </select>
                                            <td class="text-left">
                                                <select name="hide_price[]" id="input-status" class="form-control">
                                                    {% if ss_data.hide_price == '1' %} 
                                                    <option value="1" selected="selected">{{ text_enabled }}</option>
                                                    <option value="0">{{ text_disabled }}</option>
                                                    {% else %}    
                                                    <option value="1">{{ text_enabled }}</option>
                                                    <option value="0" selected="selected">{{ text_disabled }}</option>
                                                    {% endif %}
                                                </select>
                                            </td>
                                            <td class="text-left">
                                                <input type="text" class="form-control" value="{{ss_data.replace_text}}" name="replace_text[]">
                                            </td>
                                            <td class="text-left">
                                                <select name="hide_button[]" id="input-status" class="form-control">
                                                    {% if ss_data.hide_button == '1' %} 
                                                    <option value="1" selected="selected">{{ text_enabled }}</option>
                                                    <option value="0">{{ text_disabled }}</option>
                                                    {% else %}    
                                                    <option value="1">{{ text_enabled }}</option>
                                                    <option value="0" selected="selected">{{ text_disabled }}</option>
                                                    {% endif %}
                                                </select>
                                            </td>
                                            
                                            <td class="text-left">
                                                <select name="change_quantity[]" id="input-status" class="form-control">
                                                    {% if ss_data.change_quantity == '1' %} 
                                                    <option value="1" selected="selected">{{ text_enabled }}</option>
                                                    <option value="0">{{ text_disabled }}</option>
                                                    {% else %}    
                                                    <option value="1">{{ text_enabled }}</option>
                                                    <option value="0" selected="selected">{{ text_disabled }}</option>
                                                    {% endif %}
                                                </select>
                                            </td>
                                            <td class="text-left">
                                                <input type="text" class="form-control" value="{{ss_data.quantity}}" name="quantity[]">
                                            </td>
                                            <td class="text-left">
                                                <select name="call_button[]" id="input-status" class="form-control">
                                                    {% if ss_data.call_button == '1' %} 
                                                    <option value="1" selected="selected">{{ text_enabled }}</option>
                                                    <option value="0">{{ text_disabled }}</option>
                                                    {% else %}    
                                                    <option value="1">{{ text_enabled }}</option>
                                                    <option value="0" selected="selected">{{ text_disabled }}</option>
                                                    {% endif %}
                                                </select>
                                            </td>
                                            <td class="text-left">
                                                <select name="hide_from_search_category[]" id="input-status" class="form-control">
                                                    {% if ss_data.hide_from_search_category == '1' %} 
                                                    <option value="1" selected="selected">{{ text_enabled }}</option>
                                                    <option value="0">{{ text_disabled }}</option>
                                                    {% else %}    
                                                    <option value="1">{{ text_enabled }}</option>
                                                    <option value="0" selected="selected">{{ text_disabled }}</option>
                                                    {% endif %}
                                                </select>
                                            </td>
                                        
                                        <td class="text-right"><button type="button" onclick="$('#status-row{{ status_row }}').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>
                                      </tr>
                                      {% set status_row = status_row + 1 %}
                                    {% endfor %}
                                  </tbody>
                
                                  <tfoot>
                                    <tr>
                                      <td colspan="8"></td>
                                      <td class="text-right"><button type="button" onclick="addStatus();" data-toggle="tooltip" title="{{ button_status_add }}" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button></td>
                                    </tr>
                                  </tfoot>
                                </table>
                              </div>
                            
                    </div>
                    
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    <script type="text/javascript"><!--
  var status_row = 10;
  function addStatus() {
  
      html = '<tr id="status-row' + status_row + '">';
      html += '  <td class="text-left">';
      html += '  <select name="stock_status_id[]" id="input-status" class="form-control">';
    {% for stock_status in stock_statuses %}
      html += '<option value="{{ stock_status.stock_status_id }}">{{ stock_status.name }}</option>';
    {% endfor %}
      html += '  </select>';
      html += '  </td>';
      html += '  <td class="text-left">';
      html += '  <select name="hide_price[]" id="input-status" class="form-control">';
      html += '  <option value="1">{{ text_enabled }}</option>';
      html += '  <option value="0">{{ text_disabled }}</option>';
      html += '  </select>';
      html += '  </td>';
      html += '  <td class="text-left"><input type="text" name="replace_text[]" value="" placeholder="{{ entry_replace_text }}" class="form-control" /></td>';
      html += '  <td class="text-left">';
      html += '  <select name="hide_button[]" id="input-status" class="form-control">';
      html += '  <option value="1">{{ text_enabled }}</option>';
      html += '  <option value="0">{{ text_disabled }}</option>';
      html += '  </select>';
      html += '  </td>';
      html += '  <td class="text-left">';
      html += '  <select name="change_quantity[]" id="input-status" class="form-control">';
      html += '  <option value="1">{{ text_enabled }}</option>';
      html += '  <option value="0">{{ text_disabled }}</option>';
      html += '  </select>';
      html += '  </td>';
      html += '  <td class="text-left"><input type="text" name="quantity[]" value="" placeholder="{{ entry_quantity }}" class="form-control" /></td>';
      html += '  <td class="text-left">';
      html += '  <select name="call_button[]" id="input-status" class="form-control">';
      html += '  <option value="1">{{ text_enabled }}</option>';
      html += '  <option value="0">{{ text_disabled }}</option>';
      html += '  </select>';
      html += '  </td>';
      html += '  <td class="text-left">';
      html += '  <select name="hide_from_search_category[]" id="input-status" class="form-control">';
      html += '  <option value="1">{{ text_enabled }}</option>';
      html += '  <option value="0">{{ text_disabled }}</option>';
      html += '  </select>';
      html += '  </td>';
      html += '  <td class="text-right"><button type="button" onclick="$(\'#status-row' + status_row + '\').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>';
      html += '</tr>';

      $('#status tbody').append(html);

      status_row++;
  }

  $('#status tbody tr').each(function(index, element) {
      
  });
  //--></script>
    
    {{ footer }}


