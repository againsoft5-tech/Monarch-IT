<!DOCTYPE html>
<!--[if IE]><![endif]-->
<!--[if IE 8 ]><html dir="{{ direction }}" lang="{{ lang }}" class="ie8"><![endif]-->
<!--[if IE 9 ]><html dir="{{ direction }}" lang="{{ lang }}" class="ie9"><![endif]-->
<!--[if (gt IE 9)|!(IE)]><!-->
<html dir="{{ direction }}" lang="{{ lang }}">
<!DOCTYPE html>
<head>
<meta charset="UTF-8" />
<title>{{ text_print }}</title>
<script type="text/javascript" src="catalog/view/javascript/jquery/jquery-2.1.1.min.js"></script>
<link href="catalog/view/javascript/font-awesome/css/font-awesome.min.css" type="text/css" rel="stylesheet" />
<link type="text/css" href="catalog/view/theme/default/stylesheet/pc_builder_screen.css" rel="stylesheet" media="screen" />
<link type="text/css" href="catalog/view/theme/default/stylesheet/pc_builder_print.css" rel="stylesheet" media="print" />
<style>
  .print-btn{
    display: flex;
    justify-content: flex-end;
    align-items: center;
    padding: 7px 0px 7px 15px;
    margin-top: 10px;
  }
  
  @media print {
   #print{
      display: none !important;
   }
}
</style>

</head>


<body>
<div id="extension-pc-builder-pc-builder" class="main">
	<div class="printarea pc-builder-container">
		<div class="printarea-header">
			<div class="logo"><img src="{{ logo }}" /></div>
			<div class="company">
				{#<div class="name"><h1>{{ store }}</h1></div>#}
				<div class="address">{{ text_address}}: {{ address }}</div>
				<div class="telephone">{{ text_telephone }}: {{ telephone }}</div>
				<div class="email">{{ text_email }}: {{ email }}</div>
				<div class="website">{{ text_website }}: <a href="{{ website }}">{{ website }}</a></div>
				<div class="address">Build Date:: {{ "now"|date("m/d/Y") }}</div>
				
			</div>
		</div>
		<div class="separator-horizontal">&nbsp;</div>
		
		
		
		
	<div class="printarea-body">
		
		
<table style="width: 100%; border-collapse: collapse;">
                <tbody>
                <tr class="component-info" style="border: 1px solid #000;">
                <td class="component-name" style="border-right:1px solid; padding: 12px;" ><b>Component</b></td>
                <td class="component-image" style="border-right:1px solid; padding: 12px;"><b>Image</b></td>
                <td class="product-name" style="border-right:1px solid; padding: 12px;"><b>Product Name</b></td>
                <td class="price" style="border-right:1px solid; padding: 12px;"><b>Price</b></td>
                </tr>
                		
		    
		    
    	{% if pc_builder_categories %}
    	<div>
    		{% for pc_builder_category in pc_builder_categories %}
    		<div class="pc-builder-category-container">
            
            
    			{% if pc_builder_category.pc_builder_components %}
    			<div>
    				{% for pc_builder_component in pc_builder_category.pc_builder_components %}
    				{% if pc_builder_component.product %}
    				
    				    <tr class="component-info" style="border: 1px solid #000;">
    					<td style="border-right:1px solid; padding: 12px;" id="pc-builder-component-name-{{ pc_builder_category.pc_builder_category_id }}-{{ pc_builder_component.pc_builder_component_id }}" class="component-name">{{ pc_builder_component.name }} </td>
    					<td style="border-right:1px solid; padding: 12px;" id="pc-builder-component-image-{{ pc_builder_category.pc_builder_category_id }}-{{ pc_builder_component.pc_builder_component_id }}" class="component-image">{% if pc_builder_component.product %}<img src="{{ pc_builder_component.product.image }}" class="thumbnail" />{% else %}<img src="{{ pc_builder_component.thumb }}" class="thumbnail" />{% endif %}</td>
    					<td style="border-right:1px solid; padding: 12px;" id="pc-builder-component-product-{{ pc_builder_category.pc_builder_category_id }}-{{ pc_builder_component.pc_builder_component_id }}" class="component-product">
    					{% if pc_builder_component.product %}
    						{{ pc_builder_component.product.name }}
    						{% if pc_builder_component.product.option %}
								<div>
								  <div class="small">
								    {% for option in pc_builder_component.product.option %}
								    - {{ option.name }}: {{ option.value }}<br />
								    {% endfor %}
								  </div>
								</div>
    						{% endif %}
    					{% endif %}
    					</td>
    				    <td class="price" style="border-right:1px solid; padding: 12px;">
    					{% if pc_builder_component.product %}<div id="pc-builder-component-price-{{ pc_builder_category.pc_builder_category_id }}-{{ pc_builder_component.pc_builder_component_id }}" class="component-price">{{ pc_builder_component.product.price }}</div>{% endif %}
  					    </td>
  				        
 
  					
  					</tr>
  				
  					{% endif %}
    				{% endfor %}
    				
    					
    				
    			</div>
    			{% endif %}
    		</div>
    		{% endfor %}
    		
    		
    		
    	</div>
    	{% endif %}
    	
    <tr style="border: 1px solid #000;">
        <td colspan="3" class="amount-label" style="text-align: right; border-right:1px solid; padding: 12px;"><b>Total Amount:</b></td>
        <td class="amount" style="border-right:1px solid; padding: 12px;"> {{ total_amount }} </td></tr>

  </tbody>
</table>  	
    	
    	
    	
		</div>
	</div>
	

	
	
	<div class="print-btn" id="print">
	<a href="{{ print }}" id="pc-builder-print" class="pc-builder-button"><i class="fa fa-print fa-fw"></i><span class="hidden-xs hidden-sm hidden-md">{{ button_print }}</span></a>
	</div>
	
	
	
</div>
<script type="text/javascript"><!--
window.print()
//--></script>
</body>
</html>
