{{ header }}
<ul class="breadcrumb">
  {% for breadcrumb in breadcrumbs %}
  <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
  {% endfor %}
</ul>
{% set prefix = display == 'grid' ? 'ProductGrid' : 'ProductList' %}


<div id="pc-builder" class="container">
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">    
      {{ content_top }}
      <div id="pc-builder-browse" class="pc-builder-journal3 pcb-search-header">
         <div class"back-reset" style="margin-left: 7px;">
        <a href="{{ back }}" class="btn btn-default pull-left btn-top " style=" margin-right: 5px;"> Back</a>
        <a href="{{ reset }}" class="btn btn-default pull-left btn-top "> Reset</a>
      </div>
        <div id="search-form" class="pull-left search-form hidden-xs hidden-sm" style="margin-left: 10px;">
          <div class="input-group">
            <input type="text" name="search" value="{{ search }}" placeholder="{{ text_keyword }}" id="input-search" class="form-control" style="width: 400px !important; padding: 8px 6px; border:2px #ddd solid !important;" />
            
            <span class="input-group-btn">
              <button type="button" id="button-search" class="btn btn-default " style="width: 100%; padding: 11px; border-radius: 0px !important; ">{{ button_search }}</button>
            </span>
          </div><!-- /input-group -->        
        </div>
     
        <!-- Use any element to open the sidenav -->
        
        {% if products %}
        <div class="row products-filter products-filter-pcb ">
          <div class="col-md-2 col-sm-4 hidden">
            <div class="btn-group btn-group-sm">
              <button type="button" id="grid-view" class="btn btn-default" data-toggle="tooltip" title="{{ button_grid }}"><i class="fa fa-th"></i></button>
            </div>
          </div>
          <div class="col-md-3 col-sm-6 hidden">
            <div class="form-group">
              <a href="{{ compare }}" id="compare-total" class="btn btn-link">{{ text_compare }}</a>
            </div>
          </div>
          <div class="col-md-7 col-xs-12">
              <div class="select-group">
                  <div class="input-group input-group-sm sort-by">
                      <label class="input-group-addon" for="input-sort">{{ text_sort }}</label>
                      <select id="input-sort" class="form-control" onchange="location = this.value;">
                          {% for sorts in sorts %}
                              {% if sorts.value == '%s-%s'|format(sort, order) %}
                                  <option value="{{ sorts.href }}" selected="selected">{{ sorts.text }}</option>
                              {% else %}
                                  <option value="{{ sorts.href }}">{{ sorts.text }}</option>
                              {% endif %}
                          {% endfor %}
                      </select>
                  </div>
                  <div class="input-group input-group-sm per-page">
                      <label class="input-group-addon" for="input-limit">{{ text_limit }}</label>
                      <select id="input-limit" class="form-control" onchange="location = this.value;">
                          {% for limits in limits %}
                              {% if limits.value == limit %}
                                  <option value="{{ limits.href }}" selected="selected">{{ limits.text }}</option>
                              {% else %}
                                  <option value="{{ limits.href }}">{{ limits.text }}</option>
                              {% endif %}
                          {% endfor %}
                      </select>
                  </div>
              </div>
          </div>
        </div>
        {% endif %}
      </div>
       <div id="search-form-mobile" class="search-form hidden-md hidden-lg" style="display:flex; padding: 5px 10px; background: #fff; border: 1px #ddd solid; border-top: none !important;">
        <button type="button" class="btn btn-primary btn-block button-search" style="width:25%; margin-right:5px; height:34px;"> <a href="javascript:void(0);" onclick="openNav()" style="color: #fff !important;">Filter</a></button>
        <input type="text" name="search" value="{{ search }}" placeholder="{{ text_keyword }}" id="input-search" class="form-control" style="width: 100%; padding-left: 10px; border:2px #00000c solid !important;" />
        <button type="button" id="button-search-mobile" class="btn btn-primary btn-block button-search" style="width:25%; margin-left:5px; height:34px;"> {{ button_search }}</button>
      </div>
      {% if products %}
      <div class="main-products product-{{ j3.settings.get('globalProductView') }}">
          {% set display = j3.settings.get('globalProductView') %}
          {% include "journal3/template/journal3/pcbuilder_card.twig" %}
        </div>
        <div class="row pagination-row">
        <div class="col-sm-6 text-left">{{ pagination }}</div>
        <div class="col-sm-6 text-right">{{ results }}</div>
      </div>
      {% else %}
      <p>{{ text_empty }}</p>
      {% endif %}
      
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
<div id="mySidenav" class="sidenav hidden-md hidden-lg">
{{ pc_builder_filter }}
</div>

<div class="overlay"></div>
<script type="text/javascript"><!--
$('#button-search').bind('click', function() {
  var query_string = window.location.search;

	var currentUrl = '{{ server }}index.php' + query_string;

  var url = new URL(currentUrl);

	var search = $('#content #search-form input[name=\'search\']').prop('value');

	if (search) {
		url.searchParams.set('search', search);
	}

	location = url;
});

$('#content #search-form input[name=\'search\']').bind('keydown', function(e) {
	if (e.keyCode == 13) {
		$('#button-search').trigger('click');
	}
});
--></script>
<script type="text/javascript"><!--
$('#button-search-mobile').bind('click', function() {
  var query_string = window.location.search;

  var currentUrl = '{{ server }}index.php' + query_string;

  var url = new URL(currentUrl);

  var search = $('#content #search-form-mobile input[name=\'search\']').prop('value');

  if (search) {
    url.searchParams.set('search', search);
  }

  location = url;
});

$('#content #search-form-mobile input[name=\'search\']').bind('keydown', function(e) {
  if (e.keyCode == 13) {
    $('#button-search-mobile').trigger('click');
  }
});
--></script>
<script type="text/javascript"><!--
/* Set the width of the side navigation to 250px */
function openNav() {
  document.getElementById("mySidenav").style.width = "250px";
  $('.overlay').show();
}

/* Set the width of the side navigation to 0 */
function closeNav() {
  document.getElementById("mySidenav").style.width = "0";
  $('.overlay').hide();
} 
--></script>
<script type="text/javascript"><!--
$( ".overlay" ).on( "click", function() {
  closeNav();
});
--></script>


{{ footer }}