<style>

.component-product-empty {
 
   width: 250px !important

}
.page-content{
    padding: 0px !important;
}
</style>


<div id="extension-pc-builder-pc-builder" class="container pc-builder-journal3">
  {% if success %}
  <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}</div>
  {% endif %}
  {% if error_warning %}
  <div class="alert alert-warning"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
  {% endif %}
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }} page-content">{{ content_top }}
      <div id="pc-builder-container" class="pc-builder-container">
      	<div class="row header-container">
      		<div class="col-xs-3">
						<div class="logo"><img src="{{ logo }}" alt="{{ heading_title }}" title="{{ heading_title }}" class="img-responsive" /></div>
					</div>
      		<div class="col-xs-9">
      			<div id="menu-container" class="text-right">
      				<span class="button-container"><button type="button" onclick="pc_builder.cart($('#input-amount').val(), $('#input-weight').val(), $('#input-build').val());" id="pc-builder-cart" class="pc-builder-button"><i class="fa fa-shopping-cart fa-fw"></i><span class="hidden-xs hidden-sm hidden-md"><br />{{ button_cart }}</span></button></span>
      				<span class="button-container"><button type="button" onclick="pc_builder.save('');" id="pc-builder-save" class="pc-builder-button"><i class="fa fa-save fa-fw"></i><span class="hidden-xs hidden-sm hidden-md"><br />{{ button_save }}</span></button></span>
      				<span class="button-container"><a href="{{ print }}" target="_blank" id="pc-builder-print" class="pc-builder-button"><i class="fa fa-print fa-fw"></i><span class="hidden-xs hidden-sm hidden-md"><br />{{ button_print }}</span></a></span>
      				<span class="button-container"><button type="button" id="pc-builder-screenshot" class="pc-builder-button"><i class="fa fa-picture-o fa-fw"></i><span class="hidden-xs hidden-sm hidden-md"><br />{{ button_screenshot }}</span></button></span>
      				<span class="button-container"><button type="button" onclick="pc_builder.clear('');" id="pc-builder-clear" class="pc-builder-button"><i class="fa fa-refresh fa-fw"></i><span class="hidden-xs hidden-sm hidden-md"><br />{{ button_clear }}</span></button></span>
      			</div>
      		</div>
      	</div>
      	<div class="row">
      		<div class="col-sm-3">
      			<div class="sub-heading text-center">{{ text_sub_heading }}</div>
						<div class="checkbox hide-empty-component">
							<label class="small">
								<input type="checkbox" name="hide" value="1" id="input-hide" />
								{{ text_hide }}
							</label>
						</div>
      		</div>
      		<div class="col-sm-9">
      			<div id="total-container" class="text-center">
      				{#<div class="total-weight">#}
      				{#	<div class="hidden-xs hidden-sm hidden-md">{{ text_total_weight }}</div>#}
      				{#	<div><span class="hidden-lg"><i class="fa fa-balance-scale"></i> </span>{{ total_weight }}</div>#}
      				{#</div>#}
      				<div class="total-amount">
      					<div class="hidden-xs hidden-sm hidden-md">{{ text_total_amount }}</div>
      					<div><span class="hidden-lg"><i class="fa fa-shopping-bag"></i> </span>{{ total_amount }}</div>
      				</div>
      			</div>
      		</div>
      	</div>
      	{% if pc_builder_categories %}
				<form class="form-horizontal" id="form-pc-builder" style="margin-top: 15px;">
					<input type="hidden" name="amount" value="{{ amount }}" id="input-amount" />
					<input type="hidden" name="weight" value="{{ weight }}" id="input-weight" />
					<input type="hidden" name="build" value="{{ build }}" id="input-build" />
	      	<div>
	      		{% for pc_builder_category in pc_builder_categories %}
	      		<div class="pc-builder-category-container">
	      			<h4>{{ pc_builder_category.name }}</h4>
	      			{% if pc_builder_category.pc_builder_components %}
	      			<div>
	      				{% for pc_builder_component in pc_builder_category.pc_builder_components %}
	      				<div id="pc-builder-component-container-{{ pc_builder_component.pc_builder_component_id }}" class="pc-builder-component-container clearfix" data-product-selected="{% if pc_builder_component.product %}yes{% else %}no{% endif %}">
	      					<div id="pc-builder-component-image-{{ pc_builder_category.pc_builder_category_id }}-{{ pc_builder_component.pc_builder_component_id }}" class="component-image">{% if pc_builder_component.product %}<img src="{{ pc_builder_component.product.image }}" class="thumbnail" />{% else %}<img src="{{ pc_builder_component.thumb }}" class="thumbnail" />{% endif %}</div>
	      					<div id="pc-builder-component-name-product-{{ pc_builder_category.pc_builder_category_id }}-{{ pc_builder_component.pc_builder_component_id }}" class="component-name-product">
		      					<div id="pc-builder-component-name-{{ pc_builder_category.pc_builder_category_id }}-{{ pc_builder_component.pc_builder_component_id }}" class="component-name">{{ pc_builder_component.name }} {% if pc_builder_component.required %}<span class="text-danger">*</span>{% endif %}</div>
		      					<div id="pc-builder-component-product-{{ pc_builder_category.pc_builder_category_id }}-{{ pc_builder_component.pc_builder_component_id }}" class="component-product">
		      					{% if pc_builder_component.product %}
		      						{{ pc_builder_component.product.name }}
		      						{% if pc_builder_component.product.option %}
		      						<br /> <a role="button" data-toggle="collapse" href="#collapse-option-{{ pc_builder_category.pc_builder_category_id }}-{{ pc_builder_component.pc_builder_component_id }}" aria-expanded="false" aria-controls="collapse-option-{{ pc_builder_category.pc_builder_category_id }}-{{ pc_builder_component.pc_builder_component_id }}">Show options <i class="fa fa-caret-down"></i></a>
											<div class="collapse" id="collapse-option-{{ pc_builder_category.pc_builder_category_id }}-{{ pc_builder_component.pc_builder_component_id }}">
											  <div class="small">
											    {% for option in pc_builder_component.product.option %}
											    - {{ option.name }}: {{ option.value }}<br />
											    {% endfor %}
											  </div>
											</div>
		      						{% endif %}
	      						{% else %}
	      							<div class="component-product-empty">&nbsp;</div>
		      					{% endif %}
		      					</div>
	      					</div>
	      					<div id="pc-builder-component-choose-{{ pc_builder_category.pc_builder_category_id }}-{{ pc_builder_component.pc_builder_component_id }}" class="component-choose hidden-xs hidden-sm">

	      						{% if pc_builder_component.product %}
	      							<button type="button" onclick="pc_builder_product.remove('{{ pc_builder_component.pc_builder_component_id }}', '{{ pc_builder_component.product.product_id }}', '1');" id="pc-builder-product-remove-{{ pc_builder_component.product_id }}" class="btn btn-md btn-danger hidden-xs hidden-sm remove remove-desktop"><i class="fa fa-trash fa-fw"></i></button>

	      							<button type="button" onclick="pc_builder_product.remove('{{ pc_builder_component.pc_builder_component_id }}', '{{ pc_builder_component.product.product_id }}', '1');" id="pc-builder-product-remove-{{ pc_builder_component.product_id }}-mobile" class="hidden-md hidden-lg remove remove-mobile"><i class="fa fa-trash fa-fw text-danger"></i></button>
      							{% endif %}

      							<a href="{{ pc_builder_component.href }}" class="btn btn-md btn-primary hidden-xs hidden-sm"><i class="fa {% if pc_builder_component.product %}fa-refresh{% else %}fa-plus{% endif %} fa-fw"></i> <span class="hidden-xs hidden-sm hidden-md">{% if pc_builder_component.product %}{{ button_change }}{% else %}{{ button_choose }}{% endif %}</span></a>
    							</div>
	      					{% if pc_builder_component.product %}<div id="pc-builder-component-price-{{ pc_builder_category.pc_builder_category_id }}-{{ pc_builder_component.pc_builder_component_id }}" class="component-price hidden-xs hidden-sm">{{ pc_builder_component.product.price }}</div>{% endif %}

	      					<div id="pc-builder-component-choose-{{ pc_builder_category.pc_builder_category_id }}-{{ pc_builder_component.pc_builder_component_id }}-mobile" class="component-choose-mobile hidden-md hidden-lg">

	      						<div class="clearfix">
	      							<a href="{{ pc_builder_component.href }}" class="pull-right hidden-md hidden-lg"><i class="fa {% if pc_builder_component.product %}fa-refresh{% else %}fa-plus{% endif %} fa-fw"></i></a>

		      						{% if pc_builder_component.product %}
		      							<button type="button" onclick="pc_builder_product.remove('{{ pc_builder_component.pc_builder_component_id }}', '{{ pc_builder_component.product.product_id }}', '1');" id="pc-builder-product-remove-{{ pc_builder_component.product_id }}-mobile" class="pull-right hidden-md hidden-lg remove remove-mobile"><i class="fa fa-trash fa-fw text-danger"></i></button>
	      							{% endif %}
      							</div>
      							<div class="clearfix">{% if pc_builder_component.product %}<div id="pc-builder-component-price-{{ pc_builder_category.pc_builder_category_id }}-{{ pc_builder_component.pc_builder_component_id }}" class="component-price-mobile">{{ pc_builder_component.product.price }}</div>{% endif %}</div>
	      					</div>
	    					</div>
	      				{% endfor %}
	      			</div>
	      			{% endif %}
	      		</div>
	      		{% endfor %}
	      	</div>
      	</form>
      	{% endif %}
      </div>

      {% if description %}
          <div>
              {{ description }}
          </div>
          {% endif %}

    {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
<script type="text/javascript"><!--
$('#pc-builder-screenshot').on('click',function(){
	html2canvas(document.querySelector("#pc-builder-container")).then(canvas => {
    var a = document.createElement('a');
    // toDataURL defaults to png, so we need to request a jpeg, then convert for file download.
    a.href = canvas.toDataURL("image/jpeg").replace("image/jpeg", "image/octet-stream");
    a.download = '{{ text_screenshot_filename }}-pc-builder-' + getRandomString(10) + '.jpg';
    a.click();
	});
});

function getRandomString(length) {
  var randomChars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
  var result = '';
  for ( var i = 0; i < length; i++ ) {
      result += randomChars.charAt(Math.floor(Math.random() * randomChars.length));
  }
  return result;
}
--></script>
<script type="text/javascript"><!--
    $('#input-hide').change(function() {
		if($('#input-hide').is(':checked')) {
			$('div[data-product-selected="no"]').hide()
		} else {
			$('.pc-builder-component-container').show();
		}
    });
--></script>
{{ footer }}